# ==========================================
# Unity official .gitignore rules
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VS Code cache
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
crash***.dmp

# Builds
*.apk
*.aab
*.unitypackage
*.app

# ==========================================
# TypeScript / Prototype rules
# ==========================================
node_modules/
Prototype/node_modules/
dist/
Prototype/dist/
coverage/
Prototype/coverage/
.env*
*.env
*.pem
*.key
*.secret

# OS temporary files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Vite / Vitest cache
.vite/
Prototype/.vite/
*.tsbuildinfo
